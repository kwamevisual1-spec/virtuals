# Copy these names into your production host's environment settings.
# Do not put real secrets in this file or commit a populated .env file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SITE_URL=https://YOUR_PUBLIC_SITE_DOMAIN
SESSION_SECRET=GENERATE_A_STABLE_RANDOM_SECRET
# Optional server-only key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
